{
  "manifest_version": 3,
  "name": "React Click Inspector",
  "version": "0.1.0",
  "description": "Click any element in a React 18 dev build to find its source file.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "React Click Inspector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["page-inspector.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["<all_urls>"],
  "commands": {
    "activate-copy": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Activate copy path mode"
    },
    "activate-editor": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Activate open in editor mode"
    }
  }
}
