{
  "name": "react-click-inspector",
  "version": "1.1.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format cjs,esm --dts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p extension && tsc --noEmit -p extension/tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ext:build": "tsup --config extension/tsup.config.ts",
    "ext:watch": "tsup --config extension/tsup.config.ts --watch extension/src --watch extension/manifest.json --watch extension/public --watch src/core",
    "ext:test": "vitest run -c extension/vitest.config.mts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NezerAbdullayev/react-click-inspector.git"
  },
  "homepage": "https://github.com/NezerAbdullayev/react-click-inspector#readme",
  "keywords": [
    "react",
    "inspector",
    "click",
    "debug",
    "developer-tool",
    "devtools",
    "react-component"
  ],
  "bugs": {
    "url": "https://github.com/NezerAbdullayev/react-click-inspector/issues"
  },
  "license": "MIT",
  "author": "Nezer Abdullayev",
  "description": "A lightweight React tool to inspect clicks and element details for debugging UI events.",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7"
  }
}
